# ==============================================================================
# WHOLESALE Enterprise B2B Platform - Environment Variables Template
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=development
APP_PORT=8080
LOG_LEVEL=info

# Database Connection (PostgreSQL 17+)
DATABASE_URL=postgres://wholesale_admin:wholesale_secure_pass_2026@localhost:5432/wholesale?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m

# Redis Cache & Work Coordinator
REDIS_URL=redis://localhost:6379

# Authentication & OIDC Security
JWT_SECRET=replace_with_64_character_cryptographically_secure_random_string
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# S3 Compatible Object Storage (Presigned URLs & Contracts)
S3_ENDPOINT=https://s3.ap-northeast-2.amazonaws.com
S3_BUCKET_PRIVATE_DOCUMENTS=wholesale-private-docs-dev
S3_BUCKET_PUBLIC_CATALOG=wholesale-public-catalog-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Payment Gateway (Sandbox vs Live)
# Note: Live payment requires legal merchant contract with PG provider.
PG_PROVIDER=mock_sandbox
PG_CLIENT_KEY=
PG_SECRET_KEY=
PG_WEBHOOK_SECRET=

# External Services
MAIL_PROVIDER_API_KEY=
PUSH_PROVIDER_API_KEY=
FX_PROVIDER_API_KEY=

