{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "name": "wholesale-design-tokens",
  "version": "1.0.0",
  "tokens": {
    "colors": {
      "bg": {
        "canvas": "#F6F8FB",
        "surface": "#FFFFFF",
        "surfaceMuted": "#F1F5F9",
        "surfaceHover": "#E2E8F0"
      },
      "text": {
        "primary": "#172B4D",
        "secondary": "#42526E",
        "muted": "#64748B",
        "inverse": "#FFFFFF"
      },
      "brand": {
        "primaryAction": "#C2410C",
        "primaryActionHover": "#9A3412",
        "primaryActionLight": "#FFEDD5",
        "secondaryNavy": "#173A5E",
        "secondaryNavyDark": "#0F243B"
      },
      "border": {
        "default": "#D8E0EB",
        "subtle": "#E2E8F0",
        "focus": "#2563EB"
      },
      "status": {
        "success": "#15803D",
        "successBg": "#DCFCE7",
        "warning": "#B45309",
        "warningBg": "#FEF3C7",
        "danger": "#B91C1C",
        "dangerBg": "#FEE2E2",
        "info": "#1D4ED8",
        "infoBg": "#DBEAFE"
      }
    },
    "spacing": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "6": "24px",
      "8": "32px",
      "12": "48px"
    },
    "typography": {
      "fontFamily": "Noto Sans KR, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif",
      "fontSize": {
        "xs": "12px",
        "sm": "13px",
        "base": "14px",
        "md": "16px",
        "lg": "18px",
        "xl": "20px",
        "2xl": "24px",
        "3xl": "30px"
      },
      "numericFont": "tabular-nums"
    },
    "borderRadius": {
      "sm": "4px",
      "md": "6px",
      "card": "8px",
      "cardLarge": "12px",
      "pill": "9999px"
    },
    "shadows": {
      "card": "0 1px 3px rgba(0, 0, 0, 0.05), 0 1px 2px rgba(0, 0, 0, 0.02)",
      "dropdown": "0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05)"
    },
    "breakpoints": {
      "mobileSm": "360px",
      "mobile": "390px",
      "tablet": "768px",
      "desktop": "1024px",
      "wide": "1440px"
    }
  }
}

