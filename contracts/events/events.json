{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WholesaleEventContract",
  "description": "Transactional Outbox / Inbox Domain Event Schemas",
  "definitions": {
    "BaseEvent": {
      "type": "object",
      "required": ["event_id", "event_type", "aggregate_id", "aggregate_type", "timestamp", "version", "payload"],
      "properties": {
        "event_id": { "type": "string", "format": "uuid" },
        "event_type": { "type": "string" },
        "aggregate_id": { "type": "string", "format": "uuid" },
        "aggregate_type": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "version": { "type": "integer" },
        "payload": { "type": "object" }
      }
    },
    "OrderPlacedPayload": {
      "type": "object",
      "required": ["order_id", "buyer_org_id", "supplier_org_id", "total_amount_minor", "currency"],
      "properties": {
        "order_id": { "type": "string", "format": "uuid" },
        "buyer_org_id": { "type": "string", "format": "uuid" },
        "supplier_org_id": { "type": "string", "format": "uuid" },
        "total_amount_minor": { "type": "string" },
        "currency": { "type": "string" }
      }
    },
    "PaymentCapturedPayload": {
      "type": "object",
      "required": ["payment_id", "order_id", "schedule_id", "amount_minor", "currency", "pg_transaction_id"],
      "properties": {
        "payment_id": { "type": "string", "format": "uuid" },
        "order_id": { "type": "string", "format": "uuid" },
        "schedule_id": { "type": "string", "format": "uuid" },
        "amount_minor": { "type": "string" },
        "currency": { "type": "string" },
        "pg_transaction_id": { "type": "string" }
      }
    },
    "InventoryReservedPayload": {
      "type": "object",
      "required": ["reservation_id", "order_id", "sku_id", "warehouse_id", "quantity"],
      "properties": {
        "reservation_id": { "type": "string", "format": "uuid" },
        "order_id": { "type": "string", "format": "uuid" },
        "sku_id": { "type": "string", "format": "uuid" },
        "warehouse_id": { "type": "string", "format": "uuid" },
        "quantity": { "type": "string" }
      }
    },
    "DisputeOpenedPayload": {
      "type": "object",
      "required": ["dispute_id", "order_id", "claimed_amount_minor", "reason"],
      "properties": {
        "dispute_id": { "type": "string", "format": "uuid" },
        "order_id": { "type": "string", "format": "uuid" },
        "claimed_amount_minor": { "type": "string" },
        "reason": { "type": "string" }
      }
    }
  }
}

